    .gap-row {
      grid-template-columns: 11rem minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 2rem;
      padding: 1.4rem 1.5rem;
    }
  }

  .gap-row--head {
    display: none;
  }
  @media (min-width: 860px) {
    .gap-row--head {
      display: grid;
      background: var(--bg-elevated);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--muted);
    }
    .gap-row--head span:last-child {
      color: var(--accent);
