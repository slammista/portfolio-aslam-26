  .arch h2 {
    text-wrap: balance;
  }

  .arch-claim {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* ---------- Numbered blocks ---------- */

  .block {
    margin-top: 6rem;
  }

  .block-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1.25rem;
