      padding: 1.4rem 1.5rem;
    }
  }

  .gap-row--head {
    display: none;
  }
  @media (min-width: 860px) {
    .gap-row--head {
      display: grid;
      background: var(--bg-elevated);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--muted);
    }
    .gap-row--head span:last-child {
      color: var(--accent);
    }
  }

  .gap-area {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .gap-cell {
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .gap-cell--proto {
    color: var(--muted);
  }
  .gap-cell--prod {
    color: var(--fg);
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent);
  }

  /* On narrow screens the header row is gone, so each cell names itself. */
  .gap-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .gap-cell--prod .gap-label {
    color: var(--accent);
  }
  @media (min-width: 860px) {
    .gap-label { display: none; }
  }

  /* ---------- 06 Rollout ---------- */

  .rollout-lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    max-width: 58ch;
    margin-bottom: 2rem;
    text-wrap: pretty;
  }

  .rollout-steps {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  @media (min-width: 640px) {
    .rollout-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 980px) {
    .rollout-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .rollout-step {
    background: var(--bg);
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .rollout-index {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent);
  }

  .rollout-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .rollout-detail {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* ---------- Closing thesis ---------- */

  .thesis {
    margin-top: 7rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-strong);
  }

  .thesis-lines {
    max-width: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5.5vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .thesis-lines span {
    display: block;
  }
  .thesis-accent {
    color: var(--accent);
  }

  .thesis-support {
    margin-top: 1.75rem;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    max-width: 58ch;
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .tab,
    .trace-mark { transition: none; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const pattern = document.querySelector<HTMLElement>(".pattern");
  const tabs = gsap.utils.toArray<HTMLButtonElement>(".pattern [role='tab']");
  const panels = gsap.utils.toArray<HTMLElement>(".pattern [role='tabpanel']");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wide = window.matchMedia("(min-width: 1240px)");
  let running: gsap.core.Timeline | null = null;

  /* ---- The signal runs through the six stages of the visible panel, then
     down the worked case under it, row by row. Everything is readable without
     it: what moves is how far the case has got. ---- */
  function run(panel: HTMLElement) {
    const stages = gsap.utils.toArray<HTMLElement>("[data-stage]", panel);
    const links = gsap.utils.toArray<HTMLElement>(".stage-link i", panel);
    const rows = gsap.utils.toArray<HTMLElement>("[data-trace]", panel);
    const lit = [...stages, ...rows];
    const axis = wide.matches ? "scaleX" : "scaleY";

    running?.kill();
    gsap.killTweensOf(links);
    lit.forEach((e) => e.classList.remove("is-lit"));
    gsap.set(links, { scaleX: wide.matches ? 0 : 1, scaleY: wide.matches ? 1 : 0 });

    if (reduceMotion) {
      gsap.set(links, { scaleX: 1, scaleY: 1 });
      lit.forEach((e) => e.classList.add("is-lit"));
      return;
    }

    const tl = gsap.timeline({ defaults: { ease: "none" } });
    stages.forEach((stage, i) => {
      const at = i * 0.3;
      tl.call(() => stage.classList.add("is-lit"), [], at);
      if (links[i]) tl.to(links[i], { [axis]: 1, duration: 0.24 }, at + 0.04);
    });
    const start = stages.length * 0.3 + 0.2;
    rows.forEach((row, i) => tl.call(() => row.classList.add("is-lit"), [], start + i * 0.14));
    running = tl;
  }

  function select(code: string, focus = false) {
    tabs.forEach((tab) => {
      const on = tab.dataset.domain === code;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on && focus) tab.focus();
    });
    panels.forEach((panel) => {
      panel.hidden = panel.id !== `panel-${code}`;
      if (!panel.hidden) run(panel);
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab.dataset.domain ?? ""));
    // Arrow keys move between tabs, as the ARIA tabs pattern expects.
    tab.addEventListener("keydown", (e) => {
      const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next.dataset.domain ?? "", true);
    });
  });

  // Reduced motion: no sequence, so every panel starts in its finished state.
  if (reduceMotion) panels.forEach(run);

  if (pattern) {
    // First pass when the diagram scrolls into view, then on every tab switch.
    ScrollTrigger.create({
      trigger: pattern,
      start: "top 70%",
      once: true,
      onEnter: () => {
        const open = panels.find((p) => !p.hidden);
        if (open) run(open);
      },
    });
    wide.addEventListener("change", () => {
      const open = panels.find((p) => !p.hidden);
      if (open) run(open);
    });
  }
</script>
