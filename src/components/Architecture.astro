---
// The section that follows Agentic Game Studio: why the studio's architecture
// holds outside game pre-production. The thesis is the validation loop, not
// the number of agents.

// 01: the two levels of checking a proposal goes through.
const levels = [
  {
    code: "Validation",
    question: "Quello che abbiamo prodotto è corretto rispetto al problema?",
    detail: "Coerenza, completezza, vincoli del dominio. Se non passa, la proposta torna indietro.",
  },
  {
    code: "Production gate",
    question: "Siamo tecnicamente, operativamente e legalmente autorizzati a trasformarla in un'azione reale?",
    detail: "Permessi, API, tracciabilità, reversibilità, soglie. Se non è pronta, non si esegue.",
  },
];

// 02: one case walked through the loop. Smart Building, because it is where an
// answer turns into something that happens in the real world.
type TraceRow =
  | { kind: "phase"; label: string }
  | {
      kind: "step" | "pass" | "fail" | "response" | "rerun" | "action";
      label: string;
      title: string;
      detail?: string;
      checks?: string[];
    };

const trace: TraceRow[] = [
  {
    kind: "step",
    label: "Input",
    title: "\"Anomalia di riscaldamento nell'appartamento 4B\"",
    detail: "Temperatura sotto il setpoint da ore, consumo HVAC in aumento.",
  },
  {
    kind: "step",
    label: "Specialists",
    title: "HVAC, energia, occupazione, policy",
    detail: "Ognuno legge solo i propri dati. La proposta: probabile guasto alla valvola di zona, intervento tecnico in giornata.",
  },
  { kind: "phase", label: "Validation loop" },
  {
    kind: "pass",
    label: "Gate 01 · Validazione funzionale",
    title: "La diagnosi spiega davvero i dati osservati?",
  },
  {
    kind: "pass",
    label: "Gate 02 · Validazione operativa",
    title: "L'intervento rispetta i vincoli dell'edificio?",
    detail: "Comfort minimo garantito, nessun impianto safety-critical coinvolto.",
  },
  {
    kind: "fail",
    label: "Gate 03 · Security e policy",
    title: "L'azione è autorizzata? L'agente ha i permessi? È reversibile?",
    detail: "Manca: l'approvazione del property manager. L'intervento supera la soglia di spesa.",
  },
  {
    kind: "response",
    label: "Risposta del sistema",
    title: "Non esegue. Dice cosa manca e lo chiede.",
    detail: "La richiesta di approvazione parte con diagnosi e costo stimato già allegati.",
  },
  {
    kind: "rerun",
    label: "Re-run",
    title: "I controlli ripartono con il nuovo contesto",
  },
  {
    kind: "pass",
    label: "Gate 03 · di nuovo",
    title: "Approvazione presente, permessi verificati",
  },
  { kind: "phase", label: "Production gate" },
  {
    kind: "pass",
    label: "Gate 04 · Production readiness",
    title: "Si può eseguire adesso, in modo tracciabile e reversibile?",
    checks: ["API disponibile", "Permessi verificati", "Audit trail attivo", "Rollback possibile", "Costo entro soglia"],
  },
  { kind: "phase", label: "Action" },
  {
    kind: "action",
    label: "Output finale",
    title: "Work order al facility team",
    detail: "Oppure un'azione API controllata e reversibile sul BMS. L'intero percorso resta nel log.",
  },
];

const markers = { step: "→", pass: "✓", fail: "✕", response: "!", rerun: "↺", action: "→" } as const;
const outcomes = { pass: "Passa", fail: "Non passa" } as const;

// 03: what building the studio taught me.
const lessons = [
  {
    title: "Il limite non è il modello, è il contesto",
    body: "Un agente che legge tutto sbaglia di più e costa di più. Dare a ogni specialista un solo dominio della Knowledge Base ha reso le risposte più precise e i costi prevedibili.",
  },
  {
    title: "L'autorità va dichiarata, non dedotta",
    body: "Ogni ruolo ha un perimetro scritto: cosa può leggere, cosa può produrre, a chi risponde. Quando due agenti si contraddicono, decide il Director, non il caso.",
  },
  {
    title: "Un controllo che fallisce deve rimandare indietro",
    body: "Un prompt migliore non sostituisce un controllo, e un controllo che si limita a segnalare non basta. Cross-domain check e QA sono stadi separati: se un contenuto non passa, torna a chi l'ha prodotto, e nella Knowledge Base non entra.",
  },
  {
    title: "Il modello si sceglie per rischio e costo",
    body: "Haiku sui task ripetitivi e sul QA, Sonnet dove serve giudizio. Lo stesso criterio vale per qualsiasi dominio: il modello più capace solo dove l'errore costa.",
  },
  {
    title: "Quanto coinvolgere l'umano è una scelta",
    body: "Nello studio il Director approva in batch, perché i contenuti sono reversibili e il rischio è basso. Non è una regola dell'architettura: è una policy, e in un altro dominio cambia.",
  },
];

// 04: the principles that survive a change of domain. The loop comes first.
const principles = [
  { code: "02", name: "Orchestratore unico", detail: "Un punto che classifica, smista e arbitra. Gli specialisti non si chiamano a vicenda." },
  { code: "03", name: "Specialisti a contesto limitato", detail: "Ogni agente vede solo il dominio che gli serve: meno rumore, meno superficie di errore." },
  { code: "04", name: "Fonte di verità condivisa", detail: "Lo stato vive in una Knowledge Base strutturata, non nella memoria di una conversazione." },
  { code: "05", name: "Production gate separato", detail: "Una proposta corretta non è ancora un'azione autorizzata. Sono due controlli diversi." },
  { code: "06", name: "Routing per rischio", detail: "Modelli leggeri sul volume, modelli forti sulle decisioni." },
  { code: "07", name: "Umano per policy, non per default", detail: "L'umano interviene dove l'azione è costosa, irreversibile o ambigua, non dappertutto." },
];

const humanPolicy = [
  { when: "Reversibile e sotto soglia", then: "Si può automatizzare" },
  { when: "Costosa", then: "Serve un'approvazione" },
  { when: "Irreversibile", then: "Approvazione obbligatoria" },
  { when: "Caso ambiguo", then: "Escalation a un operatore" },
  { when: "Dati mancanti", then: "Il sistema chiede, non inventa" },
];

// 05: one pipeline, three domains.
const stages = [
  { key: "input", name: "Input" },
  { key: "orchestration", name: "Orchestration" },
  { key: "specialists", name: "Specialists" },
  { key: "validation", name: "Validation loop" },
  { key: "gate", name: "Production gate" },
  { key: "action", name: "Action" },
];

type Step = { title: string; detail?: string; checks?: string[] };

// One row per domain, steps in the same order as `stages`.
const domains: { code: string; name: string; kind: string; scenario: string; steps: Step[] }[] = [
  {
    code: "game",
    name: "Agentic Game Studio",
    kind: "Il prototipo, costruito",
    scenario: "Una richiesta di design attraversa lo studio e diventa documentazione approvata.",
    steps: [
      { title: "Richiesta creativa", detail: "\"Progetta la fazione dei mercanti del nord\"" },
      { title: "Game Director", detail: "Scompone la richiesta e la assegna ai reparti competenti" },
      { title: "53 agenti, 8 reparti", detail: "Lore, quest, sistemi, dialoghi: ognuno sul proprio dominio" },
      { title: "Coerenza prima di tutto", checks: ["Coerenza con il concept", "Coerenza di design", "QA e vincoli"] },
      { title: "Pronto per il documento", checks: ["Completo", "Approvato dal Director"] },
      { title: "GDD e Knowledge Base", detail: "Il contenuto viene archiviato e diventa riferimento per gli altri reparti" },
    ],
  },
  {
    code: "living",
    name: "Living operations",
    kind: "Scenario applicato, CX Living",
    scenario: "Una segnalazione di un residente diventa un intervento pianificato e una risposta chiara, con un responsabile umano sulle decisioni che costano.",
    steps: [
      { title: "Richiesta del residente", detail: "\"Il riscaldamento dell'appartamento 4B non funziona\", da app, email o chat" },
      { title: "Operations orchestrator", detail: "Classifica tipo e urgenza, recupera unità, contratto e storico ticket" },
      { title: "Triage, policy, fornitori, comunicazione", detail: "Diagnosi probabile, chi paga, fornitore disponibile, bozza di risposta" },
      { title: "Corretta per il residente e per il contratto", checks: ["Correttezza operativa", "Contratto e policy", "Privacy e permessi"] },
      { title: "Prontezza operativa", checks: ["SLA rispettato", "Entro le soglie", "Chi deve approvare"] },
      { title: "Ticket, risposta o escalation", detail: "Ticket sul gestionale e risposta al residente; sopra soglia decide il property manager" },
    ],
  },
  {
    code: "building",
    name: "Smart Building",
    kind: "Scenario applicato",
    scenario: "Un'anomalia letta dai sensori diventa una diagnosi e un'azione correttiva, senza che un agente tocchi mai direttamente un impianto critico.",
    steps: [
      { title: "Anomalia dai sensori", detail: "Consumo HVAC anomalo, temperature fuori range, allarmi dal BMS" },
      { title: "Building orchestrator", detail: "Correla e deduplica gli eventi, decide quali specialisti coinvolgere" },
      { title: "HVAC, energia, occupazione, policy", detail: "Diagnosi dell'impianto, consumi, presenze reali, vincoli d'intervento" },
      { title: "Diagnosi sostenuta dai dati", checks: ["Diagnosi tecnica", "Vincoli dell'edificio", "Sicurezza"] },
      { title: "Pronta per agire", checks: ["API autorizzata", "Audit trail", "Rollback", "Soglie di costo"] },
      { title: "Work order o azione API controllata", detail: "Mai una scrittura diretta su un impianto: solo API autorizzate e reversibili" },
    ],
  },
];

// 06: what the prototype gets away with, and what production needs.
const gaps = [
  {
    area: "Security",
    proto: "Un solo utente fidato, in locale, dentro Claude Code. Gli input arrivano da chi ha costruito il sistema.",
    prod: "Ogni input esterno è non fidato: difese da prompt injection, segreti in un vault, agenti senza credenziali dirette, dati personali minimizzati e mascherati (GDPR).",
  },
  {
    area: "Permissions",
    proto: "Il perimetro di ogni agente è definito nelle sue istruzioni e nella struttura della Knowledge Base.",
    prod: "Least privilege applicato dal sistema, non dal prompt: identità di servizio per agente, scope per edificio e unità, allowlist degli strumenti, lettura separata dalla scrittura.",
  },
  {
    area: "Observability",
    proto: "Si osserva l'output finale e, se serve, si rilegge la conversazione.",
    prod: "Tracing di ogni richiesta attraverso tutti gli stadi e tutti i giri del loop, metriche di latenza, costo e token per agente, eval continue su casi reali, alert quando la qualità deriva.",
  },
  {
    area: "Audit",
    proto: "La storia vive nei file Markdown della Knowledge Base e nel versionamento del repository.",
    prod: "Log append-only per ogni decisione: input, contesto recuperato, versione di prompt e modello, esito di ogni gate, chi ha approvato. Ogni azione è ricostruibile.",
  },
  {
    area: "Human-in-the-loop",
    proto: "Il Director approva in batch: contenuti creativi, reversibili, a basso rischio.",
    prod: "Coinvolgimento deciso per policy in base al rischio: soglie di spesa, azioni irreversibili, casi ambigui. Escalation con il contesto già pronto, interfaccia di revisione per l'operatore.",
  },
  {
    area: "API boundaries",
    proto: "Gli agenti scrivono file: il raggio d'azione è il repository.",
    prod: "Nessun accesso diretto a database, gestionale o BMS: solo API tipizzate, output validato contro schema, chiavi di idempotenza, rate limit, modalità dry-run.",
  },
  {
    area: "Failure handling",
    proto: "Se un passaggio fallisce, lo si rilancia a mano.",
    prod: "Un gate che non passa è un esito previsto, non un errore. Per i guasti veri: timeout, retry con backoff, circuit breaker, coda dei falliti. Se il modello non risponde, il caso passa a un operatore.",
  },
];

// 07: the order in which capability to act is earned.
const rollout = [
  { name: "Shadow", detail: "Il loop gira su casi reali, nessuno esegue. Si misura quante proposte passano i gate e quanto coincidono con le decisioni umane." },
  { name: "Assist", detail: "Le proposte validate arrivano all'operatore come bozze da accettare o correggere." },
  { name: "Act con approvazione", detail: "Le azioni a basso rischio partono dopo un clic, le altre restano umane." },
  { name: "Autonomia limitata", detail: "Solo le classi di azione con metriche stabili, reversibili e sotto soglia." },
];
---
<section id="architecture" class="arch">
  <div class="arch-inner">
    <p class="arch-tag" data-reveal>Oltre il gaming</p>
    <h2 data-reveal>Lo stesso pattern, altri domini.</h2>
    <p class="arch-claim" data-reveal>
      Agentic Game Studio non è interessante perché ha 53 agenti. È interessante perché nessun
      output viene considerato concluso finché non supera una sequenza di controlli, e quando un
      controllo fallisce il sistema torna indietro invece di andare avanti.
    </p>

    <!-- 01: the core idea -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">01</span>
        <h3 class="block-title">Proposte, non risposte</h3>
      </div>
      <p class="block-lede" data-reveal>
        Gli agenti producono proposte, e ogni proposta passa due controlli distinti: la validation
        verifica che sia corretta rispetto al problema, il production gate che si possa davvero
        eseguire. Una proposta può essere corretta e non ancora eseguibile.
      </p>
      <ol class="levels">
        {levels.map((l, i) => (
          <li class="level" data-reveal>
            <span class="level-code">{String(i + 1).padStart(2, "0")} · <span lang="en">{l.code}</span></span>
            <span class="level-question">{l.question}</span>
            <span class="level-detail">{l.detail}</span>
          </li>
        ))}
      </ol>
    </div>

    <!-- 02: the validation loop -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">02</span>
        <h3 class="block-title">Il validation loop</h3>
      </div>
      <p class="block-lede" data-reveal>
        Proposta → verifica → correzione se serve → production gate → output approvato. Quando un
        controllo fallisce non si procede: si capisce cosa manca o cosa è sbagliato, si riformula o
        si raccoglie l'informazione mancante, e si verifica di nuovo.
      </p>

      <!-- The loop in general: the main line, and the branch it takes on a failure. -->
      <figure class="loop" aria-labelledby="loop-caption" data-reveal>
        <figcaption id="loop-caption" class="sr-only">
          Proposta, verifica, production gate, approvazione o azione. Se la verifica fallisce si
          identifica cosa manca, si riformula e si torna alla verifica.
        </figcaption>
        <div class="loop-node loop-node--p">
          <span class="loop-name">Proposta</span>
          <span class="loop-sub">gli specialisti propongono</span>
        </div>
        <span class="loop-link loop-link--1" aria-hidden="true"></span>
        <div class="loop-node loop-node--v">
          <span class="loop-name">Verifica</span>
          <span class="loop-sub">gate funzionali, di concetto, di policy</span>
        </div>
        <span class="loop-link loop-link--2" aria-hidden="true"><span class="loop-link-label">passa</span></span>
        <div class="loop-node loop-node--g">
          <span class="loop-name">Production gate</span>
          <span class="loop-sub">si può eseguire davvero?</span>
        </div>
        <span class="loop-link loop-link--3" aria-hidden="true"></span>
        <div class="loop-node loop-node--a">
          <span class="loop-name">Approvazione / azione</span>
          <span class="loop-sub">output finale</span>
        </div>
        <div class="loop-fail">
          <span class="loop-fail-head">✕ Fallisce</span>
          <span class="loop-fail-step">Identifica cosa manca o è sbagliato</span>
          <span class="loop-fail-step">Riformula o chiede l'informazione</span>
          <span class="loop-fail-head">↺ Torna alla verifica</span>
        </div>
      </figure>

      <div class="case">
        <p class="case-lede" data-reveal>
          Un caso concreto, nel dominio dove la differenza tra una risposta e un'azione si vede di più.
        </p>
        <ol class="trace" aria-label="Smart Building: un'anomalia attraverso il loop">
          {trace.map((row) =>
            row.kind === "phase" ? (
              <li class="trace-phase" lang="en">{row.label}</li>
            ) : (
              <li class={`trace-row trace-row--${row.kind}`} data-trace>
                <span class="trace-mark" aria-hidden="true">{markers[row.kind]}</span>
                <span class="trace-body">
                  <span class="trace-label">
                    {row.label}
                    {(row.kind === "pass" || row.kind === "fail") && (
                      <span class="trace-outcome">{outcomes[row.kind]}</span>
                    )}
                  </span>
                  <span class="trace-title">{row.title}</span>
                  {row.detail && <span class="trace-detail">{row.detail}</span>}
                  {row.checks && (
                    <ul class="trace-checks">
                      {row.checks.map((c) => <li>{c}</li>)}
                    </ul>
                  )}
                </span>
              </li>
            )
          )}
        </ol>
        <p class="case-note" data-reveal>
          Non avere abbastanza informazioni è un comportamento corretto. Un sistema agentico robusto
          non inventa una risposta per forza: si ferma, dice cosa gli manca e riparte quando ce l'ha.
        </p>
      </div>
    </div>

    <!-- 03: what building the studio taught me -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">03</span>
        <h3 class="block-title">Cosa ho imparato costruendolo</h3>
      </div>
      <ol class="lessons">
        {lessons.map((l) => (
          <li class="lesson" data-reveal>
            <h4 class="lesson-title">{l.title}</h4>
            <p class="lesson-body">{l.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <!-- 04: the principles that survive a change of domain -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">04</span>
        <h3 class="block-title">I principi, con il loop al centro</h3>
      </div>
      <ul class="principles">
        <li class="principle principle--core" data-reveal>
          <span class="principle-code">01 · il principio centrale</span>
          <span class="principle-name">Il validation loop</span>
          <span class="principle-detail">
            Nessun output è finale finché non passa i suoi gate. Se un gate fallisce, la proposta
            torna indietro con quello che manca. Tutti gli altri principi servono a far funzionare questo.
          </span>
        </li>
        {principles.map((p) => (
          <li class="principle" data-reveal>
            <span class="principle-code">{p.code}</span>
            <span class="principle-name">{p.name}</span>
            <span class="principle-detail">{p.detail}</span>
          </li>
        ))}
      </ul>

      <div class="policy" data-reveal>
        <p class="policy-lede">
          Il coinvolgimento umano non è necessariamente uno step fisso: dipende dal rischio dell'azione.
        </p>
        <ul class="policy-list">
          {humanPolicy.map((p) => (
            <li class="policy-row">
              <span class="policy-when">{p.when}</span>
              <span class="policy-then">{p.then}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 05: one pipeline, three domains -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">05</span>
        <h3 class="block-title">Stesso pattern, tre domini</h3>
      </div>
      <p class="block-lede" data-reveal>
        Non è scalabile perché posso aggiungere altri agenti. È scalabile perché il processo di
        verifica è indipendente dal dominio: cambiano gli specialisti e i gate, la struttura no.
        Cambia il dominio per vedere come si riempie.
      </p>

      <figure class="pattern" data-reveal>
        <div class="tabs" role="tablist" aria-label="Dominio di applicazione">
          {domains.map((d, i) => (
            <button
              class="tab"
              type="button"
              role="tab"
              id={`tab-${d.code}`}
              data-domain={d.code}
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`panel-${d.code}`}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="tab-kind">{d.kind}</span>
              <span class="tab-name">{d.name}</span>
            </button>
          ))}
        </div>

        <!-- All panels are in the DOM up front and toggled with [hidden], as in the studio diagram. -->
        {domains.map((d, i) => (
          <div
            class="panel"
            role="tabpanel"
            id={`panel-${d.code}`}
            aria-labelledby={`tab-${d.code}`}
            hidden={i !== 0}
          >
            <p class="panel-scenario">{d.scenario}</p>
            <ol class="pipe">
              {stages.map((s, j) => (
                <li class={`stage stage--${s.key}`} data-stage>
                  <span class="stage-index">{String(j + 1).padStart(2, "0")}</span>
                  <span class="stage-name" lang="en">{s.name}</span>
                  <span class="stage-title">{d.steps[j].title}</span>
                  {d.steps[j].detail && <span class="stage-detail">{d.steps[j].detail}</span>}
                  {d.steps[j].checks && (
                    <ol class="stage-checks">
                      {d.steps[j].checks!.map((c) => <li>{c}</li>)}
                    </ol>
                  )}
                  {s.key === "validation" && <span class="stage-return">↺ se fallisce, torna indietro</span>}
                  {s.key === "gate" && <span class="stage-return">✕ se non è pronta, non si esegue</span>}
                  {j < stages.length - 1 && <span class="stage-link" aria-hidden="true"><i></i></span>}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </figure>
    </div>

    <!-- 06: prototype versus production -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">06</span>
        <h3 class="block-title">Il loop in un prototipo e in un sistema reale</h3>
      </div>
      <p class="block-lede" data-reveal>
        Il prototipo dimostra il pattern. Un sistema reale richiede infrastruttura e garanzie che un
        prototipo personale non deve avere: il loop è riutilizzabile, ma un'implementazione che apre
        ticket, parla con i residenti o muove un impianto ha bisogno di controlli molto più forti.
        Questa è la distanza, voce per voce.
      </p>

      <div class="gap-table" role="table" aria-label="Prototipo e produzione a confronto" data-reveal>
        <div class="gap-row gap-row--head" role="row">
          <span role="columnheader">Area</span>
          <span role="columnheader">Prototipo, Agentic Game Studio</span>
          <span role="columnheader">Produzione, living ops e smart building</span>
        </div>
        {gaps.map((g) => (
          <div class="gap-row" role="row">
            <span class="gap-area" role="rowheader">{g.area}</span>
            <span class="gap-cell gap-cell--proto" role="cell">
              <span class="gap-label" aria-hidden="true">Prototipo</span>
              {g.proto}
            </span>
            <span class="gap-cell gap-cell--prod" role="cell">
              <span class="gap-label" aria-hidden="true">Produzione</span>
              {g.prod}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- 07: rollout -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">07</span>
        <h3 class="block-title">Prima il loop, poi l'autonomia</h3>
      </div>
      <p class="rollout-lede" data-reveal>
        Non partirei dall'autonomia. Partirei dal loop: prima dimostri che il sistema produce proposte
        affidabili, poi misuri, poi introduci la capacità di agire, un pezzo alla volta.
      </p>
      <ol class="rollout-steps">
        {rollout.map((r, i) => (
          <li class="rollout-step" data-reveal>
            <span class="rollout-index">Fase {i + 1}</span>
            <span class="rollout-name">{r.name}</span>
            <span class="rollout-detail">{r.detail}</span>
          </li>
        ))}
      </ol>
    </div>

    <!-- Closing thesis -->
    <div class="thesis" data-reveal>
      <p class="thesis-lines" lang="en">
        <span>The domain changes.</span>
        <span>The agents change.</span>
        <span>The tools change.</span>
        <span class="thesis-accent">The validation loop stays.</span>
      </p>
      <p class="thesis-support">
        È questo che rende il pattern riutilizzabile. Non scala il numero di agenti: scala un processo
        di proposta, verifica, correzione e approvazione.
      </p>
    </div>
  </div>
</section>

<style>
  .arch {
    border-bottom: 1px solid var(--border);
  }

  .arch-inner {
    width: 90%;
    max-width: 1160px;
    margin: 0 auto;
