---
// What I built, the pattern I derived from it, where it could be applied.
// Only Agentic Game Studio is built: the other two domains are labelled as
// possible applications. Each fact about the studio was checked against its
// repository (CLAUDE.md, RULES_BASE.md, the QA agents).

type Step = { title: string; detail?: string; checks?: string[] };
type TraceRow =
  | { kind: "phase"; label: string }
  | {
      kind: "step" | "pass" | "fail" | "response" | "rerun" | "action";
      label: string;
      title: string;
      detail?: string;
      checks?: string[];
    };
type Row = { when: string; then: string };
type Domain = {
  code: string;
  name: string;
  kind: string;
  built: boolean;
  scenario: string;
  steps: Step[];
  bridge?: { title: string; rows: Row[] };
  trace?: { title: string; label: string; rows: TraceRow[] };
  groups?: { title: string; rows: Row[] };
  note?: string;
};

// 02: what building the studio taught me. Each item is an observation and the
// architectural rule it points to; nothing the Studio section already says.
const lessons = [
  {
    title: "Responsabilità delimitate",
    body: "Ogni agente ha un dominio e un'autorità scritta. Gli specialisti non si chiamano tra loro: passano dall'orchestratore, e i conflitti tra reparti li arbitra il Director.",
  },
  {
    title: "Contesto limitato",
    body: "Più contesto non dà risposte migliori, dà più rumore. Lo specialista riceve ciò che serve al suo compito, non tutto.",
  },
  {
    title: "La verifica è architettura",
    body: "Nello studio nessun contenuto viene approvato senza passare QA e Director, che possono respingerlo. Il pattern rende esplicito ciò che lì non è automatizzato: rimandare indietro, correggere, verificare di nuovo.",
  },
  {
    title: "Autorità esplicita",
    body: "Poter fare una cosa non vuol dire doverla poter fare. Nello studio ogni agente scrive solo dove la sua autorità lo permette, e un controllo di sicurezza è previsto prima di ogni scrittura.",
  },
  {
    title: "Il coinvolgimento umano è una policy",
    body: "Nello studio il Director approva in batch: contenuti creativi e reversibili. Con azioni reali la stessa scelta cambia.",
  },
];

const humanPolicy = [
  { when: "Reversibile e sotto soglia", then: "Si può automatizzare" },
  { when: "Costosa", then: "Serve un'approvazione" },
  { when: "Irreversibile", then: "Approvazione obbligatoria" },
  { when: "Caso ambiguo", then: "Escalation a un operatore" },
  { when: "Dati mancanti", then: "Il sistema chiede, non inventa" },
];

// 03: what changes and what stays when the domain changes.
const scale = [
  {
    code: "Cambia",
    question: "Il dominio, gli agenti specialisti, gli strumenti, le regole e i gate.",
    detail: "Input, conoscenza, policy e permessi sono propri di ogni dominio.",
  },
  {
    code: "Resta",
    question: "L'orchestrazione, il validation loop, il rework, il production gate e l'escalation.",
    detail: "Un processo di proposta, verifica, correzione e approvazione.",
  },
];

// 04: one pipeline, three domains.
const stages = [
  { key: "input", name: "Input" },
  { key: "orchestration", name: "Orchestration" },
  { key: "specialists", name: "Specialists" },
  { key: "validation", name: "Validation loop" },
  { key: "gate", name: "Production gate" },
  { key: "action", name: "Action" },
];

const markers = { step: "→", pass: "✓", fail: "✕", response: "!", rerun: "↺", action: "→" } as const;
const outcomes = { pass: "Passa", fail: "Non passa" } as const;

// Smart Retail's worked case: a missed opening. It ends in a notification, not
// in the system switching the alarm off: the action it may take is the one it
// is authorized and able to take.
const retailTrace: TraceRow[] = [
  {
    kind: "step",
    label: "Input",
    title: "Apertura prevista alle 09:00. Alle 09:10 l'allarme è ancora inserito, la porta è chiusa e non c'è nessuna presenza.",
  },
  {
    kind: "step",
    label: "Specialists → Proposal",
    title: "Operations, Security, Occupancy, Schedule, Policy",
    detail: "Ognuno legge solo i propri dati. Proposta: possibile mancata apertura; verificare chi può aprire e se l'allarme può essere disattivato in sicurezza.",
  },
  { kind: "phase", label: "Validation loop" },
  {
    kind: "pass",
    label: "Validation · 01",
    title: "Il negozio è davvero previsto aperto?",
    detail: "Calendario e orari lo confermano.",
  },
  {
    kind: "fail",
    label: "Validation · 02",
    title: "Un responsabile autorizzato è presente o raggiungibile?",
    detail: "No. Manca l'informazione: chi può aprire oggi.",
  },
  {
    kind: "response",
    label: "Risposta del sistema",
    title: "Non procede. Notifica il manager.",
    detail: "Con il contesto già pronto: orario previsto, stato dell'allarme, ingressi, turno assegnato.",
  },
  {
    kind: "rerun",
    label: "Re-run",
    title: "Il manager indica un responsabile reperibile: i controlli ripartono con il nuovo contesto.",
  },
  {
    kind: "pass",
    label: "Validation · 02 · di nuovo",
    title: "Responsabile reperibile autorizzato identificato.",
  },
  { kind: "phase", label: "Production gate" },
  {
    kind: "pass",
    label: "Production gate",
    title: "Si può agire adesso, in modo tracciato e reversibile?",
    checks: ["Permessi di notifica verificati", "Integrazione disponibile", "Audit trail attivo", "Nessun comando sull'allarme"],
  },
  { kind: "phase", label: "Action" },
  {
    kind: "action",
    label: "Output finale",
    title: "Procedura di apertura inviata al responsabile reperibile, ticket aperto.",
    detail: "L'allarme lo disattiva la persona autorizzata, non il sistema.",
  },
];

// Private Agentic AI's worked case: the answer the system must not invent.
const enterpriseTrace: TraceRow[] = [
  {
    kind: "step",
    label: "Input",
    title: "Un dipendente chiede: «Qual è la procedura per questa richiesta?»",
  },
  {
    kind: "step",
    label: "Orchestration → Specialists",
    title: "L'orchestratore identifica reparto, identità e autorizzazioni",
    detail: "Passa la richiesta all'agente del reparto, che cerca solo nella knowledge del reparto. Proposta: la procedura trovata nei documenti.",
  },
  { kind: "phase", label: "Validation loop" },
  {
    kind: "pass",
    label: "Validation · 01",
    title: "La fonte è pertinente e aggiornata?",
  },
  {
    kind: "fail",
    label: "Validation · 02",
    title: "Il documento necessario è accessibile a questo utente?",
    detail: "No: è fuori dal suo perimetro autorizzato. Né l'agente né l'orchestratore possono aggirare il confine.",
  },
  {
    kind: "response",
    label: "Risposta del sistema",
    title: "Non inventa una risposta. Dice cosa manca.",
    detail: "Può chiedere l'autorizzazione, usare una fonte alternativa autorizzata, inoltrare la richiesta o dichiarare che non può rispondere.",
  },
  {
    kind: "rerun",
    label: "Re-run",
    title: "Arriva l'autorizzazione o una fonte alternativa: i controlli ripartono.",
  },
  {
    kind: "pass",
    label: "Validation · 02 · di nuovo",
    title: "Fonte autorizzata, informazione sufficiente, risposta coerente con la policy.",
  },
  { kind: "phase", label: "Production gate" },
  {
    kind: "pass",
    label: "Production gate",
    title: "Si può rispondere ed eventualmente agire?",
    checks: ["Fonti citate", "Richiesta nel log", "Approvazione se serve un'azione"],
  },
  { kind: "phase", label: "Action" },
  {
    kind: "action",
    label: "Output finale",
    title: "Risposta con le fonti citate.",
  },
];

// One row per domain, steps in the same order as `stages`.
const domains: Domain[] = [
  {
    code: "game",
    name: "Agentic Game Studio",
    kind: "Costruito",
    built: true,
    scenario: "L'unico dei tre casi che esiste. Una richiesta di design attraversa lo studio e diventa contenuto approvato.",
    steps: [
      { title: "Richiesta di design", detail: "Esempio: \"Progetta la fazione dei mercanti del nord\"" },
      { title: "Director e orchestratori di reparto", detail: "Il Director smista; ogni reparto ha il suo orchestratore" },
      { title: "53 agenti, 8 reparti", detail: "Ognuno legge solo le cartelle indicate nel proprio ruolo" },
      { title: "QA Lead e cross-domain", checks: ["Coerenza tra reparti: world ↔ lore, sistemi ↔ quest", "Può respingere o chiedere revisione"] },
      { title: "Approvazione e controlli di scrittura", checks: ["Approvazione del Director, in batch", "Security guard prima di scrivere: autorità, lock, percorso", "Ogni modifica nel log"] },
      { title: "Knowledge Base", detail: "Contenuto approvato, in Markdown" },
    ],
    note: "QA e Director possono respingere o chiedere revisione, ma rimandare indietro, correggere e riverificare non è automatizzato. È la parte che il pattern rende esplicita.",
  },
  {
    code: "retail",
    name: "Smart Retail",
    kind: "Applicazione possibile · ambiente fisico",
    built: false,
    scenario: "Un negozio di abbigliamento osservato da sensori, porte, allarme, orari e consumi. Un orchestratore correla gli eventi e coinvolge specialisti con permessi delimitati: nessuno può fare tutto. Scenario ipotetico.",
    steps: [
      { title: "Eventi dal negozio", detail: "Sensori, porte, allarme, ingressi, orari" },
      { title: "Store orchestrator", detail: "Correla gli eventi e sceglie gli specialisti" },
      { title: "Operations, Security, Occupancy, HVAC, Schedule, Policy", detail: "Chi legge l'allarme non può disattivarlo" },
      { title: "La proposta è corretta?", checks: ["Eventi coerenti tra loro", "Orari e policy del dominio", "Dati sufficienti, sensori affidabili"] },
      { title: "Si può agire ora?", checks: ["Permessi e autorizzazione", "Integrazione disponibile", "Audit trail", "Azione reversibile"] },
      { title: "Azione controllata o escalation", detail: "Setpoint, ticket, notifica al manager" },
    ],
    trace: { title: "Caso guidato: mancata apertura", label: "Mancata apertura del negozio attraverso il loop", rows: retailTrace },
    groups: {
      title: "Altri casi, stesso loop",
      rows: [
        {
          when: "Temperatura fuori target: 27 °C contro 22 °C",
          then: "Controlla apertura, presenze, policy e range HVAC consentito. Se il gate passa, corregge il setpoint (reversibile, nel log); se no, raccomanda o fa escalation. Qui una risposta diventa un'azione.",
        },
        {
          when: "Mancata chiusura: 20:15, nessuna presenza autorizzata, allarme non inserito",
          then: "Verifica presenza, orario, accessi e policy. Se tutto è coerente e l'azione è autorizzata, inserisce l'allarme; se manca una condizione, non agisce e dice cosa manca.",
        },
        {
          when: "Consumo energetico anomalo",
          then: "Lo correla con temperatura, occupazione, orario e HVAC, e distingue un guasto da una telemetria inaffidabile. Propone un'azione o apre un ticket di manutenzione.",
        },
      ],
    },
    note: "Lo stesso modello si potrebbe portare in uno Smart Building: HVAC, occupancy, energia, controllo accessi e manutenzione diventerebbero altri domini specialistici.",
  },
  {
    code: "enterprise",
    name: "Private Agentic AI",
    kind: "Applicazione possibile · conoscenza aziendale",
    built: false,
    scenario: "Non un chatbot sopra tutti i documenti, ma un ambiente agentico privato che rispecchia la struttura dell'azienda: le responsabilità di ogni reparto diventano agenti con confini precisi, e conoscenza, accessi, strumenti e azioni sono controllati. Il modello sotto può essere qualunque. Scenario ipotetico.",
    steps: [
      { title: "Richiesta di un dipendente", detail: "Con la sua identità e il suo ruolo" },
      { title: "AI orchestrator", detail: "Identifica reparto, ruolo e fonte di conoscenza" },
      { title: "Un agente per reparto", detail: "HR, Finance, Legal, Operations, Sales, IT: strumenti e permessi propri" },
      { title: "La risposta è corretta e consentita?", checks: ["Fonte autorizzata e aggiornata", "Dati sufficienti", "Accessibile a chi chiede", "Coerente con la policy"] },
      { title: "Si può rispondere o agire?", checks: ["Permessi e ruolo", "Audit trail", "Approvazione se serve un'azione"] },
      { title: "Risposta con le fonti", detail: "Oppure richiesta di accesso, o rifiuto motivato" },
    ],
    bridge: {
      title: "Dallo studio all'azienda",
      rows: [
        { when: "53 ruoli in roles.json, agenti generati da un template", then: "I reparti, la knowledge, i permessi e gli strumenti di un'azienda come configurazione, non come codice" },
        { when: "Game Director e orchestratori di reparto", then: "AI orchestrator: smista ai reparti e non ne aggira i confini" },
        { when: "Knowledge Base letta per reparto", then: "Knowledge di reparto: l'agente HR non legge quella di Finance, e viceversa" },
      ],
    },
    trace: { title: "Caso guidato: la fonte che l'utente non può vedere", label: "Una domanda su un documento non accessibile attraverso il loop", rows: enterpriseTrace },
    note: "L'architettura è fissa, la conoscenza dell'organizzazione è configurabile: reparti, documenti, policy, permessi, strumenti ed escalation cambiano per ogni azienda, il sistema no. Privacy, audit e requisiti come GDPR e AI Act sono vincoli di progetto: il pattern aiuta a rispettarli, non li garantisce.",
  },
];

// 05: what the prototype gets away with, and what a real system needs.
const gaps = [
  {
    area: "Security",
    proto: "Un solo utente fidato, in locale, dentro Claude Code.",
    prod: "Ogni input esterno è non fidato: difese da prompt injection, segreti fuori dagli agenti, dati personali minimizzati.",
  },
  {
    area: "Permissions e API",
    proto: "Autorità per agente nei file di ruolo, con un controllo prima di scrivere. Il raggio d'azione è il repository.",
    prod: "Least privilege imposto dal sistema, non dal prompt: identità per agente, strumenti in allowlist, solo API tipizzate, mai accesso diretto ad allarme, HVAC o archivi.",
  },
  {
    area: "Observability",
    proto: "Si leggono l'output finale e il log delle modifiche.",
    prod: "Tracing di ogni richiesta e di ogni giro del loop, costo e latenza per agente, eval su casi reali.",
  },
  {
    area: "Audit",
    proto: "Un transaction log di ogni modifica e la storia git.",
    prod: "Log append-only per decisione: input, fonti, versione di prompt e modello, esito di ogni controllo, chi ha approvato.",
  },
  {
    area: "Failure handling",
    proto: "Lock sui file e modalità DRY-RUN; se un passaggio fallisce, lo si rilancia a mano.",
    prod: "Un controllo che non passa è un esito previsto. Per i guasti veri: timeout, retry, coda dei falliti; se il modello non risponde, il caso passa a una persona.",
  },
];

// 06: the order in which capability to act is earned.
const rollout = [
  { name: "Shadow", detail: "Il loop gira su casi reali e nessuno esegue, come la modalità DRY-RUN dello studio. Si misura quante proposte passano i gate." },
  { name: "Assist", detail: "Le proposte validate arrivano all'operatore come bozze." },
  { name: "Act con approvazione", detail: "Le azioni a basso rischio partono dopo un clic." },
  { name: "Autonomia limitata", detail: "Solo azioni reversibili, sotto soglia, con metriche stabili." },
];
---
<section id="architecture" class="arch">
  <div class="arch-inner">
    <p class="arch-tag" data-reveal>Oltre il gaming</p>
    <h2 data-reveal>Lo stesso pattern, altri domini.</h2>
    <p class="arch-claim" data-reveal>
      Ho costruito Agentic Game Studio e ne ho ricavato un pattern che non dipende dal videogame:
      proposta, verifica, correzione, approvazione. Gli altri due domini sono applicazioni
      possibili, non sistemi che ho costruito.
    </p>

    <!-- 01: the pattern -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">01</span>
        <h3 class="block-title">Il pattern: proposte, non risposte</h3>
      </div>
      <p class="block-lede" data-reveal>
        Proposta → verifica → correzione se serve → production gate → output approvato. La validation
        chiede se la proposta è corretta rispetto al problema e alle regole del dominio; il production
        gate, se siamo tecnicamente, operativamente e legalmente autorizzati a trasformarla in
        un'azione reale. Quando un controllo fallisce non si procede: si capisce cosa manca, si
        riformula o si chiede l'informazione, e si verifica di nuovo.
      </p>

      <!-- The loop: the main line, and the branch it takes on a failure. -->
      <figure class="loop" aria-labelledby="loop-caption" data-reveal>
        <figcaption id="loop-caption" class="sr-only">
          Proposta, validation, production gate, approvazione o azione. Se la validation fallisce si
          identifica cosa manca, si riformula e si torna alla validation.
        </figcaption>
        <div class="loop-node loop-node--p">
          <span class="loop-name">Proposta</span>
          <span class="loop-sub">gli specialisti propongono</span>
        </div>
        <span class="loop-link loop-link--1" aria-hidden="true"></span>
        <div class="loop-node loop-node--v">
          <span class="loop-name" lang="en">Validation</span>
          <span class="loop-sub">è corretta rispetto al dominio?</span>
        </div>
        <span class="loop-link loop-link--2" aria-hidden="true"><span class="loop-link-label">passa</span></span>
        <div class="loop-node loop-node--g">
          <span class="loop-name" lang="en">Production gate</span>
          <span class="loop-sub">siamo autorizzati a eseguirla?</span>
        </div>
        <span class="loop-link loop-link--3" aria-hidden="true"></span>
        <div class="loop-node loop-node--a">
          <span class="loop-name">Approvazione / azione</span>
          <span class="loop-sub">output finale</span>
        </div>
        <div class="loop-fail">
          <span class="loop-fail-head">✕ Fallisce</span>
          <span class="loop-fail-step">Identifica cosa manca o è sbagliato</span>
          <span class="loop-fail-step">Riformula o chiede l'informazione</span>
          <span class="loop-fail-head">↺ Torna alla validation</span>
        </div>
      </figure>

      <p class="note" data-reveal>
        Una proposta può essere corretta e non ancora eseguibile: il sistema capisce che la
        temperatura del negozio va abbassata, ma non ha ancora permessi, API o approvazione per farlo.
      </p>
    </div>

    <!-- 02: what I learned building it -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">02</span>
        <h3 class="block-title">Cosa ho imparato costruendolo</h3>
      </div>
      <ol class="lessons">
        {lessons.map((l) => (
          <li class="lesson" data-reveal>
            <h4 class="lesson-title">{l.title}</h4>
            <p class="lesson-body">{l.body}</p>
          </li>
        ))}
      </ol>

      <div class="policy" data-reveal>
        <p class="panel-group-title">Chi decide, in base al rischio dell'azione</p>
        <ul class="policy-list">
          {humanPolicy.map((p) => (
            <li class="policy-row">
              <span class="policy-when">{p.when}</span>
              <span class="policy-then">{p.then}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 03: why the pattern scales -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">03</span>
        <h3 class="block-title">Perché il pattern scala</h3>
      </div>
      <p class="block-lede" data-reveal>
        Non scala perché si aggiungono agenti: scala perché il processo di verifica si separa dal dominio.
      </p>
      <ul class="levels">
        {scale.map((l) => (
          <li class="level" data-reveal>
            <span class="level-code">{l.code}</span>
            <span class="level-question">{l.question}</span>
            <span class="level-detail">{l.detail}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- 04: three domains -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">04</span>
        <h3 class="block-title">Tre domini: uno costruito, due possibili</h3>
      </div>
      <p class="block-lede" data-reveal>
        Gli stessi sei stadi in tre domini: uno l'ho costruito, due sono applicazioni possibili.
      </p>

      <figure class="pattern" data-reveal>
        <div class="tabs" role="tablist" aria-label="Dominio di applicazione">
          {domains.map((d, i) => (
            <button
              class="tab"
              type="button"
              role="tab"
              id={`tab-${d.code}`}
              data-domain={d.code}
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`panel-${d.code}`}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="tab-kind">{d.kind}</span>
              <span class="tab-name">{d.name}</span>
            </button>
          ))}
        </div>

        <!-- All panels are in the DOM up front and toggled with [hidden], as in the studio diagram. -->
        {domains.map((d, i) => (
          <div
            class="panel"
            role="tabpanel"
            id={`panel-${d.code}`}
            aria-labelledby={`tab-${d.code}`}
            hidden={i !== 0}
          >
            <p class="panel-scenario">{d.scenario}</p>
            <ol class="pipe">
              {stages.map((s, j) => (
                <li class={`stage stage--${s.key}`} data-stage>
                  <span class="stage-index">{String(j + 1).padStart(2, "0")}</span>
                  <span class="stage-name" lang="en">{s.name}</span>
                  <span class="stage-title">{d.steps[j].title}</span>
                  {d.steps[j].detail && <span class="stage-detail">{d.steps[j].detail}</span>}
                  {d.steps[j].checks && (
                    <ol class="stage-checks">
                      {d.steps[j].checks!.map((c) => <li>{c}</li>)}
                    </ol>
                  )}
                  {s.key === "validation" && (
                    <span class="stage-return">{d.built ? "↺ può respingere; il rework non è automatizzato" : "↺ se fallisce, torna indietro"}</span>
                  )}
                  {s.key === "gate" && (
                    <span class="stage-return">{d.built ? "✕ senza approvazione resta in bozza" : "✕ se non è pronta, non si esegue"}</span>
                  )}
                  {j < stages.length - 1 && <span class="stage-link" aria-hidden="true"><i></i></span>}
                </li>
              ))}
            </ol>

            {d.bridge && (
              <div class="panel-group">
                <p class="panel-group-title">{d.bridge.title}</p>
                <ul class="policy-list">
                  {d.bridge.rows.map((r) => (
                    <li class="policy-row">
                      <span class="policy-when">{r.when}</span>
                      <span class="policy-then">{r.then}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {d.trace && (
              <div class="panel-group">
                <p class="panel-group-title">{d.trace.title} · scenario ipotetico</p>
                <ol class="trace" aria-label={d.trace.label}>
                  {d.trace.rows.map((row) =>
                    row.kind === "phase" ? (
                      <li class="trace-phase" lang="en">{row.label}</li>
                    ) : (
                      <li class={`trace-row trace-row--${row.kind}`} data-trace>
                        <span class="trace-mark" aria-hidden="true">{markers[row.kind]}</span>
                        <span class="trace-body">
                          <span class="trace-label">
                            {row.label}
                            {(row.kind === "pass" || row.kind === "fail") && (
                              <span class="trace-outcome">{outcomes[row.kind]}</span>
                            )}
                          </span>
                          <span class="trace-title">{row.title}</span>
                          {row.detail && <span class="trace-detail">{row.detail}</span>}
                          {row.checks && (
                            <ul class="trace-checks">
                              {row.checks.map((c) => <li>{c}</li>)}
                            </ul>
                          )}
                        </span>
                      </li>
                    )
                  )}
                </ol>
              </div>
            )}

            {d.groups && (
              <div class="panel-group">
                <p class="panel-group-title">{d.groups.title}</p>
                <ul class="policy-list">
                  {d.groups.rows.map((r) => (
                    <li class="policy-row">
                      <span class="policy-when">{r.when}</span>
                      <span class="policy-then">{r.then}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {d.note && <p class="note">{d.note}</p>}
          </div>
        ))}
      </figure>
    </div>

    <!-- 05: prototype versus a real system -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">05</span>
        <h3 class="block-title">Il loop in un prototipo e in un sistema reale</h3>
      </div>
      <p class="block-lede" data-reveal>
        Il prototipo dimostra che il pattern funziona. Un sistema reale deve operare in modo
        affidabile e controllato, e lì le garanzie cambiano.
      </p>

      <div class="gap-table" role="table" aria-label="Prototipo e sistema reale a confronto" data-reveal>
        <div class="gap-row gap-row--head" role="row">
          <span role="columnheader">Area</span>
          <span role="columnheader">Prototipo, Agentic Game Studio</span>
          <span role="columnheader">Sistema reale</span>
        </div>
        {gaps.map((g) => (
          <div class="gap-row" role="row">
            <span class="gap-area" role="rowheader">{g.area}</span>
            <span class="gap-cell gap-cell--proto" role="cell">
              <span class="gap-label" aria-hidden="true">Prototipo</span>
              {g.proto}
            </span>
            <span class="gap-cell gap-cell--prod" role="cell">
              <span class="gap-label" aria-hidden="true">Sistema reale</span>
              {g.prod}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- 06: rollout -->
    <div class="block">
      <div class="block-head" data-reveal>
        <span class="block-num">06</span>
        <h3 class="block-title">Prima il loop, poi l'autonomia</h3>
      </div>
      <p class="rollout-lede" data-reveal>
        Non si parte dall'autonomia: si parte dal loop. Prima si dimostra che produce proposte
        affidabili, poi si osserva, poi si agisce con approvazione, solo infine con autonomia limitata.
      </p>
      <ol class="rollout-steps">
        {rollout.map((r, i) => (
          <li class="rollout-step" data-reveal>
            <span class="rollout-index">Fase {i + 1}</span>
            <span class="rollout-name">{r.name}</span>
            <span class="rollout-detail">{r.detail}</span>
          </li>
        ))}
      </ol>
    </div>

    <!-- Closing thesis -->
    <div class="thesis" data-reveal>
      <p class="thesis-lines" lang="en">
        <span>The domain changes.</span>
        <span>The agents change.</span>
        <span>The tools change.</span>
        <span class="thesis-accent">The validation loop stays.</span>
      </p>
      <p class="thesis-support">È questo che rende il pattern riutilizzabile.</p>
    </div>
  </div>
</section>

<style>
