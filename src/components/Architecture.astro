    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent);
  }

  .tab-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .panel {
    border: 1px solid var(--border);
    border-top: none;
    padding: 2rem 1.25rem 2.25rem;
  }
  .panel[hidden] {
    display: none;
  }
  @media (min-width: 700px) {
    .panel { padding: 2.25rem 2rem 2.5rem; }
  }

  .panel-scenario {
    color: var(--muted);
    margin-bottom: 2rem;
    text-wrap: pretty;
  }

  /* One column with vertical connectors on small screens; two columns read in
     index order in the middle; a left-to-right pipe only where six stages fit. */
  .pipe {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem;
  }
  @media (min-width: 700px) and (max-width: 1239px) {
    .pipe {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .pipe .stage-link { display: none; }
  }
  @media (min-width: 1240px) {
    .pipe {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1rem 1.25rem;
    border: 1px solid var(--border-strong);
    background: var(--bg);
