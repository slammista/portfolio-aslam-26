    text-wrap: balance;
  }

  .block-lede {
    color: var(--muted);
    max-width: 62ch;
    margin-bottom: 2.5rem;
    text-wrap: pretty;
  }

  /* ---------- 01 Two levels ---------- */

  .levels {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  @media (min-width: 760px) {
    .levels { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .level {
    background: var(--bg);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 2px solid var(--accent);
  }

  .level-code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent);
  }

  .level-question {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.25;
    text-wrap: pretty;
  }

  .level-detail {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* ---------- 02 The loop ---------- */

  /* Narrow: one column, the failure branch indented under "Verifica".
     Wide: the main line runs left to right, the branch hangs under "Verifica". */
  .loop {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "p" "l1" "v" "f" "l2" "g" "l3" "a";
    max-width: 30rem;
  }
  @media (min-width: 900px) {
    .loop {
      max-width: none;
      grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr) 4.5rem minmax(0, 1fr) 2.5rem minmax(0, 1fr);
      grid-template-areas:
        "p l1 v l2 g l3 a"
        ". .  f .  . .  .";
      align-items: center;
    }
  }

  .loop-node--p { grid-area: p; }
  .loop-node--v { grid-area: v; }
  .loop-node--g { grid-area: g; }
  .loop-node--a { grid-area: a; }
  .loop-link--1 { grid-area: l1; }
  .loop-link--2 { grid-area: l2; }
  .loop-link--3 { grid-area: l3; }
  .loop-fail { grid-area: f; }

  .loop-node {
    text-align: center;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border-strong);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    align-self: stretch;
    justify-content: center;
  }
  .loop-node--v {
    border-color: var(--accent);
  }

  .loop-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .loop-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* Connectors: the same hairline as the studio diagram, here already filled. */
  .loop-link {
    position: relative;
    display: block;
    width: 1px;
    height: 2.5rem;
    background: var(--accent);
    justify-self: center;
  }
  @media (min-width: 900px) {
    .loop-link {
      width: 100%;
      height: 1px;
      justify-self: stretch;
    }
  }

  .loop-link-label {
    position: absolute;
    left: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .loop-link-label {
      left: 50%;
      top: auto;
      bottom: 0.45rem;
      transform: translateX(-50%);
    }
  }

  .loop-fail {
    margin: 1rem 0 1rem 2rem;
    padding: 1rem 1.1rem;
    border: 1px dashed var(--accent);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    position: relative;
  }
  /* On narrow screens the branch reads as an aside of "Verifica": a short
     dashed tie on its left edge. */
  .loop-fail::before {
    content: "";
    position: absolute;
    left: -2rem;
    top: 1.4rem;
    width: 2rem;
    height: 1px;
    border-top: 1px dashed var(--accent);
  }
  @media (min-width: 900px) {
    .loop-fail {
      margin: 2.5rem 0 0;
    }
    /* Two dashed ties up to "Verifica": down on failure, back up on retry. */
    .loop-fail::before,
    .loop-fail::after {
      content: "";
      position: absolute;
      top: -2.5rem;
      width: 1px;
      height: 2.5rem;
      border-top: none;
      border-left: 1px dashed var(--accent);
    }
    .loop-fail::before { left: 30%; }
    .loop-fail::after { left: 70%; }
  }

  .loop-fail-head {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent);
  }

  .loop-fail-step {
    font-size: 0.9rem;
    line-height: 1.45;
    padding-left: 1rem;
    position: relative;
  }
  .loop-fail-step::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    background: var(--accent);
  }

  /* The worked case */

  .case {
    margin-top: 4.5rem;
  }

  .case-lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    max-width: 58ch;
    margin-bottom: 2rem;
    text-wrap: pretty;
  }

  .trace {
    list-style: none;
    max-width: 46rem;
    position: relative;
  }
  /* The spine the markers sit on */
  .trace::before {
    content: "";
    position: absolute;
    left: calc(1.1rem - 0.5px);
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--border-strong);
  }

  .trace-phase {
    position: relative;
    margin: 1.75rem 0 0.75rem 3.1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .trace-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0.9rem;
    padding: 0.5rem 0;
  }

  .trace-mark {
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
    position: relative;
    transition: border-color 0.25s, color 0.25s, background 0.25s;
  }

  .trace-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.15rem 0 0.5rem;
  }

  .trace-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
  }

  .trace-outcome {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--border-strong);
    color: var(--fg);
  }

  .trace-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .trace-detail {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 58ch;
  }

  .trace-checks {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }
  .trace-checks li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border-strong);
  }
  .trace-checks li::before {
    content: "✓ ";
    color: var(--muted);
  }

  /* Outcomes: a pass is quiet, a failure is the one thing in accent. */
  .trace-row--pass .trace-mark,
  .trace-row--action .trace-mark {
    color: var(--fg);
  }
  .trace-row--fail .trace-mark {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .trace-row--fail .trace-outcome {
    border-color: var(--accent);
    color: var(--accent);
  }
  .trace-row--fail .trace-detail {
    color: var(--fg);
  }
  .trace-row--response .trace-mark,
  .trace-row--rerun .trace-mark {
    border-style: dashed;
    border-color: var(--accent);
    color: var(--accent);
  }
  .trace-row--action .trace-mark {
    border-color: var(--fg);
  }

  /* A row the scroll has reached */
  .trace-row.is-lit .trace-mark {
    border-color: var(--accent);
  }
  .trace-row--pass.is-lit .trace-mark,
  .trace-row--step.is-lit .trace-mark,
  .trace-row--action.is-lit .trace-mark {
    background: var(--bg-elevated);
  }

  .case-note {
    margin-top: 2.5rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent);
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* ---------- 03 Lessons ---------- */

  .lessons {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem 4rem;
  }
  @media (min-width: 820px) {
    .lessons { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .lesson {
    position: relative;
    padding-left: 1.1rem;
  }
  .lesson::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
