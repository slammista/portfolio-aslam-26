    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .loop-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* Connectors: the same hairline as the studio diagram, here already filled. */
  .loop-link {
