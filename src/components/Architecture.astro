  }

  .policy-lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    max-width: 58ch;
    margin-bottom: 1.5rem;
    text-wrap: pretty;
  }

  .policy-list {
    list-style: none;
    border: 1px solid var(--border);
    max-width: 46rem;
  }

  .policy-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.2rem;
    padding: 0.9rem 1.25rem;
