  .stage--orchestration,
  .stage--validation,
  .stage--gate {
    border-color: var(--accent);
  }
  .stage.is-lit {
    background: var(--bg-elevated);
  }

  .stage-index {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .stage-name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .stage-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.25;
    margin-top: 0.2rem;
  }

  .stage-detail {
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .stage-checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 0.2rem;
  }
  .stage-checks li {
    font-size: 0.84rem;
    color: var(--muted);
    line-height: 1.4;
    padding-left: 0.9rem;
    position: relative;
  }
  .stage-checks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
