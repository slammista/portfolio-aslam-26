---
// The readout is rendered from this object, so it is real JSON with real
// indentation. Each line becomes its own block so long values wrap with a
// hanging indent instead of pushing the box sideways.
const profile = {
  role: "Data & BI Analyst & Developer",
  location: "Roma, Italia",
  experience: "2+ anni",
  clients: ["Toyota", "Vodafone", "RAI", "SIAE"],
  certified: [
    "Microsoft PL-300",
    "EPICODE Data Analytics",
  ],
  core: ["Power BI", "DAX", "SQL", "Python", "Talend"],
  building: "AI LAB, applicativi in AI-assisted development",
  sideProjects: "full-stack e skill agentiche open source",
  languages: { it: "madrelingua", en: "B2" },
  available: true,
  goal: "Senior Data Analyst / Data Science",
};

const lines = JSON.stringify(profile, null, 2)
  .split("\n")
  .map((text) => ({ text, depth: text.length - text.trimStart().length }));
---
<section id="about" class="container about">
  <div class="grid-2">
    <div data-reveal>
      <h2>Data & BI Analyst e Developer.</h2>
      <p style="margin-top: 1.5rem; margin-bottom: 1rem;">
        Oltre 2 anni tra Business Intelligence, ETL enterprise e automazione. Lavoro su soluzioni Power BI in
        produzione, dall'analisi dei requisiti fino a rilascio e monitoraggio, con stakeholder di Toyota e Vodafone.
      </p>
      <p style="margin-bottom: 1rem;">
        Nel progetto interno AI LAB sviluppo applicativi come Developer con strumenti di AI-assisted development,
        e fuori dal lavoro costruisco progetti full-stack e skill agentiche open source.
      </p>
      <p>
        Il mio punto di forza è la capacità di stare tra la complessità tecnica e le esigenze di business. Capisco entrambe le lingue.
      </p>
    </div>

    <div class="readout" data-reveal>
      <div class="readout-bar">
        <span class="readout-dot"></span>
        <span>profile.json</span>
      </div>
      <pre class="readout-body">{lines.map((l) => (
        <span class="readout-line" style={`--indent: ${l.depth}ch`}>{l.text}</span>
      ))}</pre>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: 5rem;
  }

  .readout {
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
  }

  .readout-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: lowercase;
  }

  .readout-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .readout-body {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg);
    padding: 1.5rem;
    line-height: 1.7;
    /* Fallback only: lines wrap, so this is reached just by an unbreakable token. */
    overflow-x: auto;
  }

  /* One line of the file. The leading spaces stay in the text (so copying
     gives back valid, indented JSON); padding plus a matching negative
     text-indent puts the first line back at column 0 and makes wrapped
     continuations hang two characters inside the line's own indentation. */
  .readout-line {
    display: block;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding-left: calc(var(--indent) + 2ch);
    text-indent: calc(-1 * (var(--indent) + 2ch));
  }

  @media (max-width: 480px) {
    .readout-body {
      font-size: 0.8125rem;
      padding: 1.25rem 1rem;
      line-height: 1.65;
    }
  }
</style>
