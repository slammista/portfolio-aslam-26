---
// The readout is a snapshot, not a CV: who, where, what, what I'm building,
// where I'm heading. Clients, certifications and the full stack are in the
// sections below. Rendered from this object, so it is real JSON.
const profile = {
  role: "Data & BI Analyst & Developer",
  location: "Roma, Italia",
  experience: "2+ anni",
  focus: ["Data", "AI", "Automation"],
  core: ["Power BI", "SQL", "Python"],
  building: ["AI-assisted apps", "Agentic systems"],
  goal: "Data & AI Solutions Engineer",
};

// Blank lines before these keys group the file the way a person would.
const groupStarts = ["focus", "core", "building", "goal"];

type Line = { depth: number; key: string; words: string[]; gap: boolean };

// Each line is split into its key and its value, and the value into words:
// a value that does not fit moves to the next line whole, and only breaks
// between words, never inside "AI-assisted" or "Full-stack".
const lines: Line[] = JSON.stringify(profile, null, 2)
  .split("\n")
  .flatMap((text) => {
    const depth = text.length - text.trimStart().length;
    const match = text.match(/^\s*("[^"]+": )(.*)$/);
    const key = match ? match[1] : "";
    const value = match ? match[2] : text.trimStart();
    const line = { depth, key, words: value.split(" "), gap: false };
    const opensGroup = depth === 2 && groupStarts.some((k) => key === `"${k}": `);
    return opensGroup ? [{ depth, key: "", words: [], gap: true }, line] : [line];
  });
---
<section id="about" class="container about">
  <div class="grid-2">
    <div data-reveal>
      <h2>Data & BI Analyst e Developer.</h2>
      <p style="margin-top: 1.5rem; margin-bottom: 1rem;">
        Oltre 2 anni tra Business Intelligence, ETL enterprise e automazione. Lavoro su soluzioni Power BI in
        produzione, dall'analisi dei requisiti fino a rilascio e monitoraggio, con stakeholder di Toyota e Vodafone.
      </p>
      <p style="margin-bottom: 1rem;">
        Nel progetto interno AI LAB sviluppo applicativi come Developer con strumenti di AI-assisted development,
        e fuori dal lavoro costruisco progetti full-stack e skill agentiche open source.
      </p>
      <p>
        Il mio punto di forza è la capacità di stare tra la complessità tecnica e le esigenze di business. Capisco entrambe le lingue.
      </p>
    </div>

    <div class="readout" data-reveal>
      <div class="readout-bar">
        <span class="readout-dot"></span>
        <span>profile.json</span>
      </div>
      <pre class="readout-body">{lines.map((l) =>
        l.gap ? (
          <span class="readout-line readout-gap" aria-hidden="true"></span>
        ) : (
          <span class="readout-line" style={`--indent: ${l.depth}ch`}>{" ".repeat(l.depth)}{l.key}<span class="readout-value">{l.words.map((w, i) => (
            <>{i > 0 && " "}<span class="readout-word">{w}</span></>
          ))}</span></span>
        )
      )}</pre>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: 5rem;
  }

  .readout {
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
  }

  .readout-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: lowercase;
  }

  .readout-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .readout-body {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg);
    padding: 1.5rem;
    line-height: 1.7;
    /* Fallback only: lines wrap, so this is reached just by an unbreakable token. */
    overflow-x: auto;
  }

  /* One line of the file. The leading spaces stay in the text (so copying
     gives back valid, indented JSON); padding plus a matching negative
     text-indent puts the first line back at column 0 and makes a value that
     moves down hang two characters inside the line's own indentation. */
  .readout-line {
    display: block;
    white-space: pre-wrap;
    padding-left: calc(var(--indent) + 2ch);
    text-indent: calc(-1 * (var(--indent) + 2ch));
  }

  /* The value travels as one piece: next to its key if it fits, on the line
     below otherwise, and it only breaks between words. */
  .readout-value {
    display: inline-block;
    max-width: 100%;
    text-indent: 0;
    vertical-align: top;
  }

  .readout-word {
    white-space: nowrap;
  }

  .readout-gap {
    height: 0.75em;
  }

  /* Wide screens: the snapshot is short, so it can be read from across a room. */
  @media (min-width: 1200px) {
    .readout-body {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .readout-body {
      font-size: 0.8125rem;
      padding: 1.25rem 1rem;
      line-height: 1.65;
    }
  }
</style>
